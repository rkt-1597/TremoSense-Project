&pinctrl {
        pwm0_default: pwm0_default {
                group1 {
                        psels = <NRF_PSEL(PWM_OUT0, 1, 14)   // D9  - Roll servo
                                 NRF_PSEL(PWM_OUT1, 1, 15)>; // D10 - Pitch Servo
                };
        };
};

&pwm0 {
	status = "okay";
        /delete-property/ pinctrl-1;
	pinctrl-0 = <&pwm0_default>;
	pinctrl-names = "default";
};

/ {
        aliases {
                servo-roll = &roll_servo;
                servo-pitch = &pitch_servo;
        };
        spoon_motors {
                roll_servo: rollservo {
                        compatible = "ts-servos";
                        pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
                        min-pulse-us = <722>;
                        max-pulse-us = <2278>;
                        orientation = "roll";
                };
                pitch_servo: pitchservo {
                        compatible = "ts-servos";
                        pwms = <&pwm0 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
                        min-pulse-us = <722>;
                        max-pulse-us = <2278>;
                        orientation = "pitch";
                };
        };
};